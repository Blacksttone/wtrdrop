# ---- Frontend (exposed to the browser; safe public values only) ----
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Public Razorpay key id (optional, enables "Pay online")
VITE_PAYMENT_GATEWAY_KEY=rzp_test_xxxxxxxxxxxx
# Public site URL; the Android app uses it for links that leave the device
VITE_PUBLIC_SITE_URL=https://waterdrop.<your-subdomain>.workers.dev

# ---- Server only (Supabase Edge Function secrets — NEVER prefix with VITE_) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Email notifications via Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="Waterdrop <alerts@yourdomain.com>"
# Optional WhatsApp provider (Meta WhatsApp Cloud API compatible)
WHATSAPP_PROVIDER_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
# Payment gateway (Razorpay)
PAYMENT_GATEWAY_KEY=rzp_test_xxxxxxxxxxxx
PAYMENT_GATEWAY_SECRET=your-razorpay-key-secret
PAYMENT_GATEWAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Shared secret used by schedulers to call the run-scheduled-jobs function
CRON_SECRET=generate-a-long-random-string
# Public URL of the deployed app (used in email links)
APP_URL=https://waterdrop.<your-subdomain>.workers.dev
